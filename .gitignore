# --- secrets --------------------------------------------------------------
.env
.env.local
*.pem
*.key

# --- data -----------------------------------------------------------------
# 6.2 GB of AIS + SAR lives here. The repo ships code, not corpora.
#
# NOTE the trailing /* rather than a bare data/ -- git does not descend into an
# excluded *directory*, so `data/` followed by `!data/foo` silently fails to
# re-include foo. `data/*` excludes the contents instead, which lets the
# negations below actually work.
data/*
!data/.gitkeep
!data/sar_manifest.txt
!data/sar_manifest_pt_fix.txt

# --- python ---------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# --- SAR / geo intermediates ----------------------------------------------
*.zip
*.SAFE/
*.tif
*.tiff
!docs/**/*.png

# --- local tooling --------------------------------------------------------
.DS_Store
*.log
