# NIGHTGLASS — configuration template.
#
#   cp .env.example .env
#
# Copy this to .env and fill in. .env is gitignored; this file is committed.
#
# ---------------------------------------------------------------------------
# CREDENTIALS
# ---------------------------------------------------------------------------
# You do NOT need to set credentials here if you keep them centrally.
#
# scripts/load-env.sh sources ~/.config/eo-credentials.env first, then this
# project's .env, so:
#
#   blank here      -> defers to the central file (the normal case)
#   filled in here  -> overrides it, e.g. for a throwaway or scoped token
#
# Leaving a key blank is safe: the loader treats an empty value as "no
# opinion" rather than letting it clobber a good central credential.
#
# Global Fishing Watch — https://globalfishingwatch.org/our-apis/tokens
# Licence CC BY-NC 4.0: non-commercial, attribution required in the README.
GFW_TOKEN=
#
# NASA Earthdata (Sentinel-1 downloads from ASF) is NOT an env var.
# It lives in ~/.netrc, which curl/wget/GDAL/rasterio read automatically:
#
#   machine urs.earthdata.nasa.gov
#   login    YOUR_USER
#   password YOUR_PASS
#
#   chmod 600 ~/.netrc
#
# A valid Earthdata login is NOT sufficient on its own. You must also
# authorise "Alaska Satellite Facility Data Access" and accept the Sentinel
# EULA once, in a browser, at https://urs.earthdata.nasa.gov/profile
# Without it, downloads return 401 "Could Not Login. Be sure to agree to the
# EULA." even though the same credentials work fine against CMR.

# ---------------------------------------------------------------------------
# AOI — everything is config-driven; nothing is hardcoded (EXECUTION_SPEC §3.1)
# ---------------------------------------------------------------------------
# Active area of interest. Swap this one value to switch deployments.
#   lisbon    Portugal, demo AOI      — Tagus approaches
#   leixoes   Portugal, demo AOI      — Porto approaches, 3 overlapping S1 paths
#   kattegat  Denmark, validation AOI — real point-level DMA AIS
#
# Deliberately still undecided between the two Portuguese options: the AIS
# recorder covers BOTH (see NIGHTGLASS_RECORD_BBOX), so the choice can be made
# after Friday's scenes land rather than before.
NIGHTGLASS_AOI=lisbon

# Portugal — Lisbon / Tagus approaches. 81 Sentinel-1 GRD granules in Jun 2026,
# highest measured count. Narrative: EMSA's Copernicus Maritime Surveillance,
# the restricted SAR+AIS service this project shadows, is run out of Lisbon.
AOI_LISBON_BBOX=-10.5,38.0,-8.5,39.5
AOI_LISBON_AIS_SOURCE=aisstream
# Sentinel-1 overpass windows, UTC. Measured from the catalogue during pre-dev,
# not taken from a revisit table -- S1A retired 29 Jun 2026 and the S1C/S1D
# repeat pattern is shifted a day from the old A/B cycle.
AOI_LISBON_PASS_DESCENDING=06:33-06:51
AOI_LISBON_PASS_ASCENDING=18:26-18:43

# Portugal — Leixões / Porto approaches. Three overlapping paths (125/45/147)
# instead of two, so ~50% more acquisitions.
AOI_LEIXOES_BBOX=-9.8,40.9,-8.6,41.6
AOI_LEIXOES_AIS_SOURCE=aisstream
# Not separately measured; Lisbon's windows are the working assumption until
# Leixoes scenes are on disk. Same paths cross both, roughly the same clock.
AOI_LEIXOES_PASS_DESCENDING=06:33-06:51
AOI_LEIXOES_PASS_ASCENDING=18:26-18:43

# Denmark — Kattegat / the Belts. 72 granules in Jul 2026.
AOI_KATTEGAT_BBOX=10.5,55.5,12.5,57.5
AOI_KATTEGAT_AIS_SOURCE=dma
# NB the ascending lower bound is 16:44, NOT the 16:52 the pre-dev guide gives.
# 16:44 appears 10x across 72 July 2026 granules, so a 16:52 bound silently
# drops about a third of ascending passes.
AOI_KATTEGAT_PASS_DESCENDING=05:23-05:40
AOI_KATTEGAT_PASS_ASCENDING=16:44-17:09

# ---------------------------------------------------------------------------
# AIS RECORDER — union of both Portuguese footprints
# ---------------------------------------------------------------------------
# Covers Lisbon AND Leixões with margin, so the AOI decision stays open.
# You can always filter down; you can never back-fill.
#
# NOTE the axis order: aisstream takes [[lat, lon], [lat, lon]], the OPPOSITE
# of most GIS tooling. Getting this backwards yields a silently empty stream.
NIGHTGLASS_RECORD_BBOX_LAT=38.0,42.5
NIGHTGLASS_RECORD_BBOX_LON=-11.5,-8.0
AISSTREAM_URL=wss://stream.aisstream.io/v0/stream

# ---------------------------------------------------------------------------
# DATA SOURCES
# ---------------------------------------------------------------------------
# Danish AIS. NOTE: the widely-cited https://web.ais.dk/aisdata/ is DEAD --
# its TLS cert expired 12 Jun 2025 and the host now hangs. The service moved
# to a public S3 bucket. Plain http:// only; https:// fails on this host.
DMA_AIS_BASE_URL=http://aisdata.ais.dk.s3.eu-central-1.amazonaws.com

# ASF Search. No auth required for SEARCH -- only for download.
ASF_SEARCH_URL=https://api.daac.asf.alaska.edu/services/search/param

# ---------------------------------------------------------------------------
# DETECTOR
# ---------------------------------------------------------------------------
# Minimum vessel length to report, metres. EXECUTION_SPEC §5 default.
NIGHTGLASS_MIN_LENGTH_M=15.0

# ---------------------------------------------------------------------------
# SERVICES
# ---------------------------------------------------------------------------
POSTGRES_USER=nightglass
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=nightglass
POSTGRES_HOST=postgis
POSTGRES_PORT=5432

QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=nightglass_docs

# ---------------------------------------------------------------------------
# DOCUMENT CORPUS (M2)
# ---------------------------------------------------------------------------
# Two roots because the corpus has two halves held differently: corpus/ is
# committed (synthetic memos + the source manifest, so a fresh clone can
# reproduce the demo), data/corpus/ is fetched by `make fetch-corpus` and
# gitignored (some sources carry no reuse licence). Ingest reads both.
# These are paths INSIDE the container -- see the x-corpus mounts in compose.
NIGHTGLASS_CORPUS_DIR=/app/data/corpus
NIGHTGLASS_SYNTHETIC_DIR=/app/corpus/synthetic

# doc_search default k, per EXECUTION_SPEC §5.
NIGHTGLASS_RAG_TOP_K=8

# Retrieval score floor, cosine against bge-m3. Deliberately UNSET by default.
# Measured on this corpus over 11 probe questions: answerable ones score
# 0.543-0.708 on their best chunk, unanswerable ones 0.440-0.497. The bands do
# not overlap, but they are separated by only 0.046 -- far too narrow a margin
# to hang a refusal on, since the cost of a threshold set slightly high is that
# answerable questions start refusing, which looks exactly like the honesty
# feature working correctly. Refusal is decided by citation verification
# instead, which needs no threshold to be right. Set this only if you have
# measured your own corpus.
# NIGHTGLASS_RAG_MIN_SCORE=0.52

OLLAMA_HOST=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen2.5:14b-instruct-q4_K_M
OLLAMA_EMBED_MODEL=bge-m3
